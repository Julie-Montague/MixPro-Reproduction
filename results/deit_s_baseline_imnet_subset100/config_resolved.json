{
  "run": {
    "name": "deit_s_baseline_imnet_subset100",
    "seed": 42
  },
  "model": {
    "name": "deit_s",
    "num_classes": 1000,
    "drop_path_rate": 0.1,
    "pretrained": true
  },
  "data": {
    "data_dir": "data/imagenet1k_subset_100pc",
    "img_size": 224,
    "crop_pct": 0.875,
    "interpolation": "bicubic",
    "batch_size": 128,
    "num_workers": 10,
    "pin_memory": true,
    "use_randaugment": true,
    "ra_num_ops": 9,
    "ra_magnitude": 15,
    "random_erasing_prob": 0.25,
    "seed": 42
  },
  "train": {
    "eval_every": 5,
    "epochs": 100,
    "warmup_epochs": 10,
    "label_smoothing": 0.1,
    "amp": true,
    "grad_accum_steps": 1
  },
  "optim": {
    "name": "adamw",
    "lr": 0.0005,
    "warmup_lr": 1e-06,
    "lr_min": 1e-05,
    "weight_decay": 0.05
  },
  "mix": {
    "use_mixpro": false,
    "mixup_alpha": 0.0,
    "cutmix_alpha": 0.0,
    "prob": 0.0,
    "switch_prob": 0.0,
    "mode": "batch"
  }
}